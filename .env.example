# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# Passed to Jaspr at build time with --dart-define (see CLAUDE.md section 5).

# Apps Script web app URL (deployed in M3), e.g. https://script.google.com/macros/s/<id>/exec
EMC_API_URL=
# Shared secret stored in the script's Script Properties
EMC_API_KEY=
